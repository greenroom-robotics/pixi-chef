---
source: tests/prepare.rs
expression: "recipe(\"source_chain\", \"ws/pixi.toml\")"
---
=== base/package.xml
<package format="3">
  <name>base</name>
  <version>0.1.0</version>
</package>

=== base/pixi.toml
[package]
name = "base"
version = "0.1.0"

=== top/package.xml
<package format="3">
  <name>top</name>
  <version>0.1.0</version>
</package>

=== top/pixi.lock
version: 7

=== top/pixi.toml
[package]
name = "top"
version = "0.1.0"

=== ws/pixi.lock
version: 7
platforms:
- name: linux-64
environments:
  default:
    channels:
    - url: https://prefix.dev/conda-forge/
    packages:
      linux-64:
      - conda_source: top[bbbbbbbb] @ ../top
      - conda_source: base[cccccccc] @ ../base
packages:
- conda_source: top[bbbbbbbb] @ ../top
  variants:
    target_platform: linux-64
  depends:
  - base
- conda_source: base[cccccccc] @ ../base
  variants:
    target_platform: linux-64

=== ws/pixi.toml
[workspace]
name = "source_chain"
channels = ["https://prefix.dev/conda-forge"]
platforms = ["linux-64"]

[dependencies]
top = { path = "../top" }
