---
source: tests/prepare.rs
expression: "recipe_with(\"variants\", \"variants/base/pixi.toml\", &options)?"
---
=== pkg/app/cmake/deps.cmake
set(X 1)

=== pkg/app/package.xml
<package format="3">
  <name>app</name>
  <version>0.1.0</version>
</package>

=== pkg/app/pixi.toml
[package]
name = "app"
version = "0.1.0"

=== variants/base/pixi.lock
version: 7
platforms:
- name: linux-64
environments:
  default:
    channels:
    - url: https://prefix.dev/conda-forge/
    packages:
      linux-64:
      - conda_source: app[aaaaaaaa] @ ../../pkg/app
packages:
- conda_source: app[aaaaaaaa] @ ../../pkg/app
  variants:
    target_platform: linux-64

=== variants/base/pixi.toml
[workspace]
name = "variants_base"
channels = ["https://prefix.dev/conda-forge"]
platforms = ["linux-64"]

[dependencies]
app = { path = "../../pkg/app" }
