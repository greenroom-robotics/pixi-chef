---
source: tests/prepare.rs
expression: "recipe(\"conda_source\", \"pixi.toml\")"
---
=== app/CMakeLists.txt
cmake_minimum_required(VERSION 3.8)
project(app)

=== app/package.xml
<package format="3">
  <name>app</name>
  <version>0.1.0</version>
</package>

=== app/pixi.toml
[package]
name = "app"
version = "0.1.0"

=== pixi.lock
version: 7
platforms:
- name: linux-64
environments:
  default:
    channels:
    - url: https://prefix.dev/conda-forge/
    packages:
      linux-64:
      - conda_source: app[aaaaaaaa] @ app
packages:
- conda_source: app[aaaaaaaa] @ app
  variants:
    target_platform: linux-64

=== pixi.toml
[workspace]
name = "conda_source"
channels = ["https://prefix.dev/conda-forge"]
platforms = ["linux-64"]

[dependencies]
app = { path = "app" }
